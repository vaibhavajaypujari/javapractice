class Solution {

    static class Node {
        int len;
        char leftChar;
        char rightChar;
        int leftLen;
        int rightLen;
        int maxLen;

        Node() {
        }

        Node(char c) {
            len = 1;
            leftChar = c;
            rightChar = c;
            leftLen = 1;
            rightLen = 1;
            maxLen = 1;
        }
    }

    Node[] tree;
    char[] str;

    public int[] longestRepeating(
            String s,
            String queryCharacters,
            int[] queryIndices) {

        // Convert String to character array
        str = s.toCharArray();

        // IMPORTANT: String uses length()
        int n = s.length();

        tree = new Node[4 * n];

        build(1, 0, n - 1);

        int k = queryIndices.length;
        int[] answer = new int[k];

        for (int i = 0; i < k; i++) {

            int index = queryIndices[i];
            char newChar = queryCharacters.charAt(i);

            // Update actual string
            str[index] = newChar;

            // Update segment tree
            update(1, 0, n - 1, index, newChar);

            // Root contains the answer for entire string
            answer[i] = tree[1].maxLen;
        }

        return answer;
    }

    private void build(int node, int left, int right) {

        if (left == right) {
            tree[node] = new Node(str[left]);
            return;
        }

        int mid = left + (right - left) / 2;

        build(node * 2, left, mid);
        build(node * 2 + 1, mid + 1, right);

        tree[node] = merge(
                tree[node * 2],
                tree[node * 2 + 1]
        );
    }

    private void update(
            int node,
            int left,
            int right,
            int index,
            char value) {

        if (left == right) {
            tree[node] = new Node(value);
            return;
        }

        int mid = left + (right - left) / 2;

        if (index <= mid) {
            update(node * 2, left, mid, index, value);
        } else {
            update(node * 2 + 1, mid + 1, right, index, value);
        }

        tree[node] = merge(
                tree[node * 2],
                tree[node * 2 + 1]
        );
    }

    private Node merge(Node a, Node b) {

        Node res = new Node();

        res.len = a.len + b.len;

        res.leftChar = a.leftChar;
        res.rightChar = b.rightChar;

        // Calculate prefix length
        res.leftLen = a.leftLen;

        if (a.leftLen == a.len &&
            a.rightChar == b.leftChar) {

            res.leftLen = a.len + b.leftLen;
        }

        // Calculate suffix length
        res.rightLen = b.rightLen;

        if (b.rightLen == b.len &&
            a.rightChar == b.leftChar) {

            res.rightLen = b.len + a.rightLen;
        }

        // Best answer from either side
        res.maxLen = Math.max(
                a.maxLen,
                b.maxLen
        );

        // Combine suffix of left + prefix of right
        if (a.rightChar == b.leftChar) {

            res.maxLen = Math.max(
                    res.maxLen,
                    a.rightLen + b.leftLen
            );
        }

        return res;
    }
}
