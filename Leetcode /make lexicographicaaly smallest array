class Solution { 
    public int[] lexicographicallySmallestArray(int[] nums, int limit) { 
        int n = nums.length; 
        
        int[][] arr = new int[n][2]; 
        
        // Store value and original index
        for(int i = 0; i < n; i++) { 
            arr[i][0] = nums[i]; 
            arr[i][1] = i; 
        } 
        
        // Sort by value
        Arrays.sort(arr, (a, b) -> Integer.compare(a[0], b[0])); 
        
        int st = 0; 
        
        while(st < n) { 
            int end = st; 
            
            // Find the current connected group
            while(end + 1 < n && 
                  (long) arr[end + 1][0] - arr[end][0] <= limit) { 
                end++; 
            } 
            
            List<Integer> vals = new ArrayList<>(); 
            List<Integer> ind = new ArrayList<>(); 
            
            // Collect values and original indices
            for(int i = st; i <= end; i++) { 
                vals.add(arr[i][0]); 
                ind.add(arr[i][1]); 
            } 
            
            // To get lexicographically smallest result,
            // assign smallest values to smallest indices.
            Collections.sort(ind); 
            
            for(int i = 0; i < ind.size(); i++) { 
                nums[ind.get(i)] = vals.get(i); 
            } 
            
            st = end + 1; 
        } 
        
        return nums; 
    } 
}
