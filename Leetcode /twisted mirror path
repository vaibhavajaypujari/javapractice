class Solution {
    int mod;
    int[][][] dp; 
    public int uniquePaths(int[][] grid) {
        mod=(int)1e9+7;
        dp=new int[grid.length][grid[0].length][2];
        for(int i[][]:dp) for(int j[]:i) Arrays.fill(j,-1);
        return compute(0,0,0,grid);
    }
    public int compute(int i,int j,int dir,int[][] grid){
        if(Math.min(i,j)<0||(i>=grid.length)||(j>=grid[0].length)) return 0;
        if(dp[i][j][dir]!=-1) return dp[i][j][dir];
        if(i==grid.length-1&&j==grid[0].length-1) return 1;
        int ans=0;
        if(grid[i][j]==1){
            if(dir==1) ans+=compute(i,j+1,(dir+1)%2,grid);
            else ans+=compute(i+1,j,(dir+1)%2,grid);
            ans%=mod;
        }else{
            ans+=compute(i+1,j,1,grid);
            ans%=mod;
            ans+=compute(i,j+1,0,grid);
            ans%=mod;
        }
        return dp[i][j][dir]=ans%mod;
    }
}
